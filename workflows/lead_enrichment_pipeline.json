    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst p = raw.body ?? raw;\nconst PERSONAL = new Set(['gmail.com','googlemail.com','yahoo.com','yahoo.co.uk','ymail.com','hotmail.com','hotmail.co.uk','outlook.com','live.com','msn.com','aol.com','icloud.com','me.com','proton.me','protonmail.com','gmx.com','mail.com','zoho.com']);\nconst str = v => (v ?? '').toString().trim();\nconst normDomain = d => str(d).toLowerCase().replace(/^[a-z]+:[/][/]/, '').replace(/^www[.]/, '').split(/[/?#:]/)[0].replace(/[.]$/, '');\nconst cleanPhone = v => {\n  const s = str(v);\n  if (!s) return '';\n  const digits = s.replace(/[^0-9]/g, '');\n  const intl = s.startsWith('+') || s.startsWith('00');\n  const core = s.startsWith('00') ? digits.slice(2) : digits;\n  if (core.length < 7 || core.length > 15) return '';\n  return (intl ? '+' : '') + core;\n};\nconst email = str(p.email).toLowerCase();\nconst EMAIL_RE = /^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$/;\nconst isValid = EMAIL_RE.test(email) && !email.includes('..');\nconst emailDomain = isValid ? email.split('@')[1] : '';\nconst isPersonal = isValid && PERSONAL.has(emailDomain);\nconst isCorporate = isValid && !isPersonal;\nlet domain = normDomain(p.domain);\nif (PERSONAL.has(domain)) domain = '';\nif (!domain && isCorporate) domain = emailDomain;\nconst errors = [];\nif (!isValid) errors.push('invalid_email_format');\nreturn [{ json: {\n  first_name: str(p.first_name),\n  last_name: str(p.last_name),\n  email,\n  company_name: str(p.company_name),\n  domain,\n  phone: cleanPhone(p.phone),\n  email_domain: emailDomain,\n  is_valid_email: isValid,\n  is_personal_email: isPersonal,\n  is_corporate_email: isCorporate,\n  validation_errors: errors,\n  received_at: new Date().toISOString()\n} }];"
      },
