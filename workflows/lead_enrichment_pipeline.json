    {
      "parameters": {
        "jsCode": "const lead = $('Validate & Clean Lead').first().json;\nconst resp = $input.first().json ?? {};\nconst org = resp.organization ?? null;\nconst num = v => (v === null || v === undefined || v === '' || !Number.isFinite(Number(v))) ? null : Number(v);\nconst techs = org ? [...new Set([\n  ...(Array.isArray(org.technology_names) ? org.technology_names : []),\n  ...(Array.isArray(org.current_technologies) ? org.current_technologies.map(t => t && t.name) : [])\n].filter(Boolean).map(t => String(t).trim()))] : [];\nconst e = {\n  employee_count: org ? num(org.estimated_num_employees) : null,\n  estimated_revenue: org ? num(org.annual_revenue ?? org.organization_revenue) : null,\n  industry: org?.industry ?? null,\n  technologies_used: techs,\n  city: org?.city ?? null,\n  country: org?.country ?? null\n};\nconst missing = Object.entries(e)\n  .filter(([k, v]) => v === null || (Array.isArray(v) && v.length === 0))\n  .map(([k]) => k);\nlet status = 'complete';\nlet reason = null;\nif (!lead.domain) { status = 'skipped'; reason = 'no_enrichment_domain'; }\nelse if (resp.error) { status = 'failed'; reason = String(resp.error?.message ?? resp.error); }\nelse if (!org) { status = 'failed'; reason = 'no_organization_match'; }\nelse if (missing.length === 6) { status = 'failed'; reason = 'empty_organization_record'; }\nelse if (missing.length > 0) { status = 'partial'; }\nreturn [{ json: {\n  ...lead,\n  company_name: lead.company_name || org?.name || '',\n  ...e,\n  enrichment_status: status,\n  enrichment_missing_fields: missing,\n  enrichment_error: reason\n} }];"
      },
      "id": "23e15b5e-f1bc-462f-a23d-2846bd261b27",
      "name": "Normalize Enrichment (Fallback Safe)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst TARGET = ['hubspot', 'salesforce', 'marketo', 'webflow'];\nconst n = d.employee_count;\nconst size = n === null ? 0 : n > 50 ? 30 : n >= 10 ? 15 : 5;\nconst matched = (d.technologies_used || []).filter(t => TARGET.some(k => String(t).toLowerCase().includes(k)));\nconst tech = matched.length ? 30 : 0;\nconst corp = d.is_corporate_email ? 20 : 0;\nconst checks = [d.first_name, d.last_name, d.email, d.company_name, d.phone, d.domain, d.employee_count, d.estimated_revenue, d.industry, (d.technologies_used || []).length ? 'y' : '', d.city, d.country];\nconst filled = checks.filter(v => v !== null && v !== undefined && v !== '').length;\nconst completeness = Math.round(20 * filled / checks.length);\nconst score = Math.min(100, size + tech + corp + completeness);\nconst tier = score >= 75 ? 1 : score >= 50 ? 2 : 3;\nconst tierLabel = tier === 1 ? 'Tier 1 - Enterprise / High Intent' : tier === 2 ? 'Tier 2 - Mid-Market' : 'Tier 3 - SMB / Low Intent';\nconst priority = tier === 1 ? 'High' : tier === 2 ? 'Medium' : 'Low';\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fullName = ((d.first_name || '') + ' ' + (d.last_name || '')).trim() || d.email;\nconst stack = (d.technologies_used || []).slice(0, 15).join(', ') || 'Unknown';\nconst emoji = tier === 1 ? ':fire:' : ':chart_with_upwards_trend:';\nconst headline = tier === 1 ? 'HOT LEAD' : 'New Mid-Market Lead';\nconst blocks = [\n  { type: 'header', text: { type: 'plain_text', text: (emoji + ' ' + headline + ': ' + fullName).slice(0, 150), emoji: true } },\n  { type: 'section', fields: [\n    { type: 'mrkdwn', text: '*Company:*\\n' + esc(d.company_name || 'Unknown') },\n    { type: 'mrkdwn', text: '*Lead Score:*\\n' + score + '/100 (Tier ' + tier + ')' },\n    { type: 'mrkdwn', text: '*Employees:*\\n' + (n === null ? 'Unknown' : n) },\n    { type: 'mrkdwn', text: '*Industry:*\\n' + esc(d.industry || 'Unknown') }\n  ] },\n  { type: 'section', text: { type: 'mrkdwn', text: '*Tech Stack:*\\n' + esc(stack) } },\n  { type: 'context', elements: [ { type: 'mrkdwn', text: esc(d.email) + ' | ' + esc(d.domain || 'no domain') + ' | enrichment: ' + d.enrichment_status } ] }\n];\nreturn [{ json: {\n  ...d,\n  lead_score: score,\n  lead_tier: tier,\n  tier_label: tierLabel,\n  lead_priority: priority,\n  matched_target_tech: matched,\n  score_breakdown: { company_size: size, tech_fit: tech, corporate_email: corp, data_completeness: completeness },\n  slack_text: headline + ': ' + fullName + ' (' + (d.company_name || 'Unknown') + ') - Score ' + score + '/100',\n  slack_payload: JSON.stringify({ blocks })\n} }];"
      },
